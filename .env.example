# Copy to .env locally — NEVER commit real secrets.
# Production secrets go in Vercel + Hostinger worker env only.

# App
NODE_ENV=development
APP_URL=https://video.inovaauto.com
APP_NAME=Vidoo AI

# MySQL only (Hostinger production + local XAMPP)
# Format: mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
# Local example (empty password OK for XAMPP root):
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"
# Production Hostinger placeholders (set real values in env only):
# DB_NAME=u417315406_Video1
# DB_USER=u417315406_u4173154012
# DATABASE_URL="mysql://u417315406_u4173154012:DB_PASSWORD@DB_HOST:3306/u417315406_Video1"

# Session (min 32 chars; use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Telegram (set in Vercel / worker env — leave empty in committed files)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=https://video.inovaauto.com/mini-app

# Admin (comma-separated Telegram user IDs)
ADMIN_TELEGRAM_IDS=

# Logging
LOG_LEVEL=info

# Storage (object keys only in DB — never large binaries)
# On Vercel, local disk is ephemeral — plan durable storage for production media
STORAGE_PROVIDER=local
# Durable absolute path on Hostinger worker host (NOT ephemeral Vercel disk):
# STORAGE_ROOT=/home/USER/apps/vidoo-ai/storage/objects
UPLOAD_MAX_BYTES=5242880
TEMPLATE_COVER_MAX_BYTES=5242880
TEMPLATE_PREVIEW_MAX_BYTES=52428800
GENERATED_VIDEO_MAX_BYTES=104857600
UPLOAD_TEMP_TTL_HOURS=24

# Transactional Telegram notifications (not marketing)
TELEGRAM_NOTIFY_ENABLED=true

# AI providers (credentials from env only)
AI_DEFAULT_PROVIDER=mock
# Mock is for local/tests only — set false in production
AI_ALLOW_MOCK_PROVIDER=true
KLING_API_KEY=
KLING_API_BASE_URL=
VEO_API_KEY=
VEO_API_BASE_URL=

# Job worker
GENERATION_JOB_MAX_ATTEMPTS=3
GENERATION_JOB_TIMEOUT_MS=900000
GENERATION_JOB_LOCK_MS=30000
GENERATION_POLL_INTERVAL_MS=5000

# Payments (provider pluggable; not activated by default)
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=stub
